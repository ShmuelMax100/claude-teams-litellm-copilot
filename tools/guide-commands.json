[
  {
    "id": "prepare",
    "command": "./setup admin prepare --gateway https://gateway.example --upstream https://fusion.internal.example/v1",
    "context": "Administrator: verify the deployed gateway"
  },
  {
    "id": "enroll",
    "command": "./setup admin enroll --gateway https://gateway.example --upstream https://fusion.internal.example/v1 --user-id developer-id --github-login developer-login --tier standard --out private/developer.invite.json --apply",
    "context": "Administrator: issue a personal invitation"
  },
  {
    "id": "join",
    "command": "./setup developer join --invite /path/to/personal-invitation.json",
    "context": "Developer: connect Claude Code"
  },
  {
    "id": "doctor",
    "command": "./setup doctor",
    "context": "Developer: check settings and authorization"
  },
  {
    "id": "models",
    "command": "./setup models",
    "context": "List the Fusion tiers"
  }
]
